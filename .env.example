# --- LOCAL DEVELOPMENT ---
# Database
POSTGRES_USER=energtx_user
POSTGRES_PASSWORD=energtx_pass
POSTGRES_DB=energtx
DATABASE_URL=postgres://energtx_user:energtx_pass@localhost:5432/energtx
# When running backend in Docker alongside postgres container, use:
# DATABASE_URL=postgres://energtx_user:energtx_pass@db:5432/energtx

# Redis
REDIS_URL=redis://localhost:6379/0
# When running backend in Docker alongside redis container, use:
# REDIS_URL=redis://redis:6379/0

# Backend Server
PORT=8080
RUST_LOG=info,energtx=debug

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- GCP DEPLOYMENT PLACEHOLDERS ---
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=us-central1
# GCP_ARTIFACT_REGISTRY=us-central1-docker.pkg.dev/your-gcp-project-id/energtx-repo
